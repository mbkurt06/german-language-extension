{
  "manifest_version": 3,
  "name": "German Language Context",
  "version": "0.1.0",
  "description": "Context-first German subtitle analysis for ZDF, ARD and YouTube.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.zdf.de/*",
    "https://*.ardmediathek.de/*",
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/youtube-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.zdf.de/*",
        "https://*.ardmediathek.de/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/youtube-cues.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "German Language Context"
  },
  "options_page": "src/options.html"
}
